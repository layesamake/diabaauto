# Diaba Auto — Modèle de variables d'environnement
# Copiez ce fichier en .env.local pour le développement local.
# Ne commitez jamais .env.local, .env, ni aucune valeur secrète réelle.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Diaba Auto"

# -----------------------------------------------------------------------------
# Supabase — valeurs publiques utilisables côté navigateur
# -----------------------------------------------------------------------------
# URL du projet Supabase de développement/staging, pas production.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Clé anon/public Supabase de développement/staging.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# -----------------------------------------------------------------------------
# Supabase / PostgreSQL — serveur uniquement
# -----------------------------------------------------------------------------
# Chaîne de connexion PostgreSQL poolée pour l'application côté serveur.
# Exemple Supabase pooler : postgresql://postgres.PROJECT_REF:PASSWORD@aws-...pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=""

# Chaîne directe utilisée par Prisma pour les migrations.
# Exemple Supabase direct : postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL=""

# Clé service role Supabase — SECRET CRITIQUE.
# À utiliser uniquement côté serveur pour les opérations autorisées.
# Ne jamais exposer en NEXT_PUBLIC_* ni dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Auth / sécurité applicative
# -----------------------------------------------------------------------------
# Secret applicatif pour signatures internes/idempotence si nécessaire.
# Générer une valeur longue et aléatoire par environnement.
APP_SECRET=""

# Domaine autorisé pour les redirections Auth.
AUTH_REDIRECT_URL="http://localhost:3000/auth/callback"

# -----------------------------------------------------------------------------
# Contact Diaba Auto — à valider par l'exploitant
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""

# Numéro WhatsApp public utilisé par le CTA des fiches véhicule (BR-120/BR-121).
# Format E.164 sans espaces. Valeur par défaut si la variable est absente : +221782254040
# (valeur initiale documentée BR-120, à confirmer par l'exploitant).
NEXT_PUBLIC_WHATSAPP_NUMBER="+221782254040"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_ADDRESS=""
NEXT_PUBLIC_CONTACT_CITY=""
NEXT_PUBLIC_CONTACT_COUNTRY="Sénégal"

# -----------------------------------------------------------------------------
# Stockage Supabase
# -----------------------------------------------------------------------------
SUPABASE_BUCKET_VEHICLE_IMAGES="vehicle-images"
SUPABASE_BUCKET_VEHICLE_DOCUMENTS="vehicle-documents"
SUPABASE_BUCKET_AVATARS="avatars"
SUPABASE_BUCKET_APP_ASSETS="app-assets"

# -----------------------------------------------------------------------------
# Analytics / monitoring — optionnel en V1 tant que l'outil n'est pas validé
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
NEXT_PUBLIC_ANALYTICS_PROVIDER=""
NEXT_PUBLIC_ANALYTICS_ID=""

# -----------------------------------------------------------------------------
# Déploiement / environnement
# -----------------------------------------------------------------------------
# development | preview | staging | production
# Commande aussi la sécurité HTTP : HSTS n'est émis qu'avec APP_ENV=production, et
# 'unsafe-eval' n'apparaît dans la CSP qu'avec APP_ENV=development (docs/contrat-lot-8.md T51/T52).
APP_ENV="development"

# Important : ne jamais utiliser la base de production en développement ou preview.
ALLOW_PRODUCTION_DATABASE="false"
